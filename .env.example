# === Produção (portal eq04.dsc.rodrigor.com → Editar variáveis) ===
# O docker-compose do servidor usa DB_PASSWORD para montar a URL do banco.
DB_PASSWORD=SUA_SENHA_DO_PORTAL

# Banco compartilhado da disciplina (host = postgres dentro da rede Docker)
DATABASE_URL=postgresql://eq04:SUA_SENHA_DO_PORTAL@postgres:5432/eq04?connection_limit=5

# Auth.js / NextAuth
AUTH_SECRET=gere_com_openssl_rand_base64_32
AUTH_URL=https://eq04.dsc.rodrigor.com

# IA — LiteLLM da disciplina (compatível com SDK OpenAI)
OPENAI_API_KEY=sk-sua-chave-litellm
OPENAI_MODEL=gpt-4o-mini
